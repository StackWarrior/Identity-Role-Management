@model Identity_Role_Management.ViewModels.ManageUserRolesViewModel
@{
    ViewData["Title"] = "Manage Roles";
}

<div class="container mt-4" style="max-width:600px">
    <h2>Manage Roles</h2>
    <p class="text-muted">
        User: <strong>@Model.UserName</strong> — @Model.UserEmail
    </p>

    <form asp-action="ManageUserRoles" method="post">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="UserName" />
        <input type="hidden" asp-for="UserEmail" />

        <div class="card">
            <div class="card-body">
                @for (int i = 0; i < Model.Roles.Count; i++)
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox"
                               asp-for="Roles[i].IsSelected"
                               id="role_@i" />
                        <input type="hidden" asp-for="Roles[i].RoleId" />
                        <input type="hidden" asp-for="Roles[i].RoleName" />
                        <label class="form-check-label fw-semibold" for="role_@i">
                            @Model.Roles[i].RoleName
                        </label>
                    </div>
                }
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-success">Save Changes</button>
            <a asp-controller="Users" asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>